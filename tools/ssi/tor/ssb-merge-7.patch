++++++++
++++++++          set -e
++++++++          echo "Deleting caches..."
++++++++
++++++++          i=1
++++++++          while [ "$i" -le 10 ]; do
++++++++            gh actions-cache list -R $REPO -L 100 --sort created-at --order asc | while IFS=$'\t' read -r cacheKey _ branch _
