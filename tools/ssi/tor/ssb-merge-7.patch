+                "https://www.google.com/dl/release2",
+                sanitizedUrl,
+            )
+
+            version = re.search(r".*?_([\d]+\.[\d]+\.[\d]+\.[\d]+)/", sanitizedUrl)
+            if version is None:
+                raise Exception(
+                    "{} cannot extract version '{}'".format(cdm["target"], sanitizedUrl)
+                )
+            if any_version is None:
