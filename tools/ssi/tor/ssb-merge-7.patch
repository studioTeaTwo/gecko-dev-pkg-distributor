++++++++// experiment api
++++++++// refs: browser/extensions/selfsovereignidentity/experiment-apis/addonsSelfsovereignidentity.json
++++++++declare namespace browser.ssi {
++++++++  interface Credential {
++++++++    protocolName: ProtocolName
++++++++    credentialName: string
++++++++    primary: boolean
++++++++    secret: string
++++++++    identifier: string
++++++++    trustedSites: object[]
++++++++    properties: object
++++++++    guid?: string
