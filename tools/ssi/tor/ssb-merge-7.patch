++++++++    let credentialData = {
++++++++      protocolName,
++++++++      credentialName,
++++++++    };
++++++++    let matchData = {};
++++++++    for (let field of ["protocolName", "credentialName"]) {
++++++++      if (credentialData[field] != "") {
++++++++        matchData[field] = credentialData[field];
++++++++      }
++++++++    }
