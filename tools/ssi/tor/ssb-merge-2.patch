++/**
++ * SsiStorage implementation for the JSON back-end.
++ */
++
++const lazy = {};
++
++ChromeUtils.defineESModuleGetters(lazy, {
++  SsiStore: "resource://gre/modules/SsiStore.sys.mjs",
++  SsiHelper: "resource://gre/modules/SsiHelper.sys.mjs",
++});
