++        trustedSites: item.trustedSites.filter(
++          (site) => site.url !== removedSite.url
++        ),
++      })
++    }
++
++    // Notify to the buit-in extension
++    // TODO(ssb): make TrustedSitesChanged a separate event.
++    setTimeout(() => {
