++    [Op, Credential[]]
++  >([null, []])
++
++  // Only do once
++  useEffect(() => {
++    window.addEventListener(
++      "AboutSelfsovereignidentityChromeToContent",
++      receiveFromChildActor
++    )
++    return () => {
++      window.removeEventListener(
++        "AboutSelfsovereignidentityChromeToContent",
++        receiveFromChildActor
++      )
++    }
