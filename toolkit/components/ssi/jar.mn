toolkit.jar:
%   content ssi %content/ssi/
% resource ssi %ssi/
#ifdef ANDROID
  ssi/ssistorage.sys.mjs (./ssi-storage-geckoview.sys.mjs)
#else
  ssi/ssistorage.sys.mjs (./ssi-storage-desktop.sys.mjs)
#endif
  ssi/protocols/Bitcoin.sys.mjs (./protocols/Bitcoin.sys.mjs)
  ssi/protocols/Nostr.sys.mjs (./protocols/Nostr.sys.mjs)
  ssi/protocols/_shortw_utils.sys.mjs (./protocols/noble-curves/_shortw_utils.sys.mjs)
  ssi/protocols/curve.sys.mjs (./protocols/noble-curves/abstract/curve.sys.mjs)
  ssi/protocols/hash-to-curve.sys.mjs (./protocols/noble-curves/abstract/hash-to-curve.sys.mjs)
  ssi/protocols/modular.sys.mjs (./protocols/noble-curves/abstract/modular.sys.mjs)
  ssi/protocols/utils-curves.sys.mjs (./protocols/noble-curves/abstract/utils.sys.mjs)
  ssi/protocols/weierstrass.sys.mjs (./protocols/noble-curves/abstract/weierstrass.sys.mjs)
  ssi/protocols/secp256k1.sys.mjs (./protocols/noble-curves/secp256k1.sys.mjs)
  ssi/protocols/_assert.sys.mjs (./protocols/noble-hashes/_assert.sys.mjs)
  ssi/protocols/_sha2.sys.mjs (./protocols/noble-hashes/_sha2.sys.mjs)
  ssi/protocols/crypto.sys.mjs (./protocols/noble-hashes/crypto.sys.mjs)
  ssi/protocols/hmac.sys.mjs (./protocols/noble-hashes/hmac.sys.mjs)
  ssi/protocols/sha256.sys.mjs (./protocols/noble-hashes/sha256.sys.mjs)
  ssi/protocols/utils-hashes.sys.mjs (./protocols/noble-hashes/utils.sys.mjs)
