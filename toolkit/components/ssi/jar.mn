toolkit.jar:
% content ssi %content/ssi/
  content/ssi/dialogs/confirmAuthorization.css    (./dialogs/confirmAuthorization.css)
  content/ssi/dialogs/confirmAuthorization.js    (./dialogs/confirmAuthorization.js)
  content/ssi/dialogs/confirmAuthorization.xhtml (./dialogs/confirmAuthorization.xhtml)
% resource ssi %ssi/
#ifdef ANDROID
  ssi/ssistorage.sys.mjs (./ssi-storage-geckoview.sys.mjs)
#else
  ssi/ssistorage.sys.mjs (./ssi-storage-desktop.sys.mjs)
#endif
  ssi/protocols/Bitcoin.sys.mjs (./protocols/Bitcoin.sys.mjs)
  ssi/protocols/Nostr.sys.mjs (./protocols/Nostr.sys.mjs)
  ssi/protocols/ciphers/_arx.sys.mjs (./protocols/noble-ciphers/_arx.sys.mjs)
  ssi/protocols/ciphers/_assert.sys.mjs (./protocols/noble-ciphers/_assert.sys.mjs)
  ssi/protocols/ciphers/_poly1305.sys.mjs (./protocols/noble-ciphers/_poly1305.sys.mjs)
  ssi/protocols/ciphers/_polyval.sys.mjs (./protocols/noble-ciphers/_polyval.sys.mjs)
  ssi/protocols/ciphers/aes.sys.mjs (./protocols/noble-ciphers/aes.sys.mjs)
  ssi/protocols/ciphers/chacha.sys.mjs (./protocols/noble-ciphers/chacha.sys.mjs)
  ssi/protocols/ciphers/utils.sys.mjs (./protocols/noble-ciphers/utils.sys.mjs)
  ssi/protocols/curves/_shortw_utils.sys.mjs (./protocols/noble-curves/_shortw_utils.sys.mjs)
  ssi/protocols/curves/secp256k1.sys.mjs (./protocols/noble-curves/secp256k1.sys.mjs)
  ssi/protocols/curves/curve.sys.mjs (./protocols/noble-curves/abstract/curve.sys.mjs)
  ssi/protocols/curves/hash-to-curve.sys.mjs (./protocols/noble-curves/abstract/hash-to-curve.sys.mjs)
  ssi/protocols/curves/modular.sys.mjs (./protocols/noble-curves/abstract/modular.sys.mjs)
  ssi/protocols/curves/utils.sys.mjs (./protocols/noble-curves/abstract/utils.sys.mjs)
  ssi/protocols/curves/weierstrass.sys.mjs (./protocols/noble-curves/abstract/weierstrass.sys.mjs)
  ssi/protocols/hashes/_assert.sys.mjs (./protocols/noble-hashes/_assert.sys.mjs)
  ssi/protocols/hashes/_md.sys.mjs (./protocols/noble-hashes/_md.sys.mjs)
  ssi/protocols/hashes/crypto.sys.mjs (./protocols/noble-hashes/crypto.sys.mjs)
  ssi/protocols/hashes/hkdf.sys.mjs (./protocols/noble-hashes/hkdf.sys.mjs)
  ssi/protocols/hashes/hmac.sys.mjs (./protocols/noble-hashes/hmac.sys.mjs)
  ssi/protocols/hashes/sha256.sys.mjs (./protocols/noble-hashes/sha256.sys.mjs)
  ssi/protocols/hashes/utils.sys.mjs (./protocols/noble-hashes/utils.sys.mjs)
  ssi/protocols/scure-base.sys.mjs (./protocols/scure-base/index.sys.mjs)
