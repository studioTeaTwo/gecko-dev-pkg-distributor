[
  {
    "namespace": "manifest",
    "types": [
      {
        "$extend": "OptionalPermission",
        "choices": [
          {
            "type": "string",
            "enum": ["ssi"]
          }
        ]
      }
    ]
  },
  {
    "namespace": "ssi",
    "description": "That's to realize the self-sovereign identity.",
    "permissions": ["ssi"],
    "types": [
      {
        "id": "SearchCriteria",
        "type": "object",
        "description": "Criteria to search credentials. If you want a full search, explicitly set primary to false.",
        "properties": {
          "protocolName": {
            "type": "string",
            "optional": true,
            "default": "",
            "description": "The protocol name to search"
          },
          "credentialName": {
            "type": "string",
            "optional": true,
            "default": "",
            "description": "The credential name to search"
          },
          "primary": {
            "type": "boolean",
            "optional": true,
            "default": true,
            "description": "The primary flag to search"
          }
        }
      },
      {
        "id": "DialogInfo",
        "type": "object",
        "description": "Parameters to build Auth dialog",
        "properties": {
          "caption": {
            "type": "string",
            "optional": true,
            "default": "AUTH LOCK",
            "description": "A text description of the authentication"
          },
          "submission": {
            "type": "string",
            "optional": true,
            "default": "",
            "description": "Reference data for considering auth"
          },
          "enforce": {
            "type": "boolean",
            "optional": true,
            "default": false,
            "description": "Set to true if you want to perform auth dialog even if trusted site or password authorization is valid."
          }
        }
      }
    ],
    "functions": [
      {
        "name": "searchCredentialsWithoutSecret",
        "type": "function",
        "description": "Return the requested credentials without secret",
        "async": true,
        "parameters": [
          {
            "name": "criteria",
            "$ref": "SearchCriteria",
            "description": "Criteria to search credentials"
          },
          {
            "name": "dialogOption",
            "$ref": "DialogInfo",
            "optional": true,
            "description": "Parameters to build Auth dialog"
          }
        ]
      },
      {
        "name": "askPermission",
        "type": "function",
        "description": "Ask the user whether to give a permission to the requsting web app",
        "parameters": [
          {
            "name": "protocolName",
            "type": "string",
            "description": "The protocol name targeted"
          },
          {
            "name": "credentialName",
            "type": "string",
            "description": "The credential name targeted"
          },
          {
            "name": "dialogOptions",
            "$ref": "DialogInfo",
            "optional": true,
            "description": "Parameters to build Auth dialog"
          }
        ],
        "async": true
      },
      {
        "name": "askPermissionChild",
        "type": "function",
        "description": "Ask the user whether to give a permission to the requsting web app",
        "parameters": [
          {
            "name": "protocolName",
            "type": "string",
            "description": "The protocol name targeted"
          }
        ],
        "async": true
      }
    ]
  }
]
