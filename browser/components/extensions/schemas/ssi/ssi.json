[
  {
    "namespace": "manifest",
    "types": [
      {
        "$extend": "OptionalPermission",
        "choices": [
          {
            "type": "string",
            "enum": ["ssi"]
          }
        ]
      }
    ]
  },
  {
    "namespace": "ssi",
    "description": "That's to realize the self-sovereign identity.",
    "permissions": ["ssi"],
    "types": [
      {
        "id": "Credential",
        "type": "object",
        "description": "A credential object picked selectively from `nsICredentialInfo` and `nsICredentialMetaInfo` in the SSI store service.",
        "properties": {
          "protocolName": {
            "type": "string",
            "description": "The protocol name"
          },
          "credentialName": {
            "type": "string",
            "description": "The credential name"
          },
          "identifier": {
            "type": "string",
            "optional": true,
            "default": "",
            "description": "The identifier"
          },
          "primary": {
            "type": "boolean",
            "description": "The primary flag"
          }
        }
      },
      {
        "id": "SearchCriteria",
        "type": "object",
        "description": "Criteria to search credentials. If you want a full search, explicitly set primary to false.",
        "properties": {
          "protocolName": {
            "type": "string",
            "optional": true,
            "default": "",
            "description": "The protocol name to search"
          },
          "credentialName": {
            "type": "string",
            "optional": true,
            "default": "",
            "description": "The credential name to search"
          },
          "primary": {
            "type": "boolean",
            "optional": true,
            "default": true,
            "description": "The primary flag to search"
          }
        }
      },
      {
        "id": "DialogInfo",
        "type": "object",
        "description": "Option parameters to build Auth dialog",
        "properties": {
          "caption": {
            "type": "string",
            "optional": true,
            "default": "",
            "description": "A text description of the authentication. Base title is generated by the system, so add additional information as needed."
          },
          "submission": {
            "type": "string",
            "optional": true,
            "default": "",
            "description": "Reference data for considering auth. Evidence of signed messages, etc. are generated by the system, so add additional information as needed."
          },
          "enforce": {
            "type": "boolean",
            "optional": true,
            "default": false,
            "description": "Set to true if you want to perform auth dialog even if trusted site or password authorization is valid."
          }
        }
      }
    ],
    "functions": [
      {
        "name": "searchCredentialsWithoutSecret",
        "type": "function",
        "description": "Return the requested credentials without secrets such like secret key and private setting. During the execution process, an internal authorization check is performed similar to `ssi.askConsent`.",
        "async": true,
        "parameters": [
          {
            "name": "criteria",
            "$ref": "SearchCriteria",
            "description": "Criteria to search credentials"
          },
          {
            "name": "dialogOption",
            "$ref": "DialogInfo",
            "optional": true,
            "description": "Parameters to build Auth dialog"
          }
        ],
        "returns": {
          "type": "array",
          "description": "A Promise that will be fulfilled with `array` of `ssi.Credential`.",
          "items": {
            "$ref": "Credential"
          }
        }
      },
      {
        "name": "askConsent",
        "type": "function",
        "description": "Ask the user whether to give a permission to the requsting web app",
        "parameters": [
          {
            "name": "protocolName",
            "type": "string",
            "description": "The protocol name targeted"
          },
          {
            "name": "credentialName",
            "type": "string",
            "description": "The credential name targeted"
          },
          {
            "name": "dialogOptions",
            "$ref": "DialogInfo",
            "optional": true,
            "description": "Parameters to build Auth dialog"
          }
        ],
        "async": true,
        "returns": {
          "type": "boolean",
          "description": "A Promise that will be fulfilled with a `boolean` value to indicate the authorization result."
        }
      },
      {
        "name": "askConsentChild",
        "type": "function",
        "description": "Ask the user whether to give a permission to the requsting web app",
        "parameters": [
          {
            "name": "protocolName",
            "type": "string",
            "description": "The protocol name targeted"
          }
        ],
        "async": true,
        "returns": {
          "type": "boolean",
          "description": "A Promise that will be fulfilled with a `boolean` value to indicate the authorization result."
        }
      }
    ]
  }
]
