[
  {
    "namespace": "manifest",
    "types": [
      {
        "$extend": "OptionalPermission",
        "choices": [
          {
            "type": "string",
            "enum": ["ssi", "ssi.nostr"]
          }
        ]
      }
    ]
  },
  {
    "namespace": "ssi.nostr",
    "description": "Nostr subset of browser.ssi. Requires `ssi.nostr` along with `ssi` to set permissions.",
    "permissions": ["ssi", "ssi.nostr"],
    "events": [
      {
        "name": "onPrimaryChanged",
        "type": "function",
        "description": "Fire when primary key changed",
        "parameters": []
      },
      {
        "name": "onPrefEnabledChanged",
        "type": "function",
        "description": "Fire when the preference value of `selfsovereignidentity.nostr.enabled` changed",
        "parameters": []
      }
    ],
    "functions": [
      {
        "name": "getPrefs",
        "type": "function",
        "description": "Get preference's values",
        "parameters": [],
        "async": true
      },
      {
        "name": "sign",
        "type": "function",
        "description": "Pass message and return the signature by Nostr secret key",
        "async": true,
        "parameters": [
          {
            "name": "message",
            "type": "string",
            "description": "The message to sign. If it's not a string it must be stringified."
          },
          {
            "name": "option",
            "type": "object",
            "description": "Direction about sign detail",
            "properties": {
              "type": {
                "type": "string",
                "description": "'signEvent'"
              }
            }
          },
          {
            "name": "dialogOption",
            "$ref": "ssi.DialogInfo",
            "optional": true,
            "description": "Parameters to build Auth dialog"
          }
        ]
      }
    ]
  }
]
