browser.jar:
% content selfsovereignindividual %content/selfsovereignindividual/ contentaccessible=yes
  content/selfsovereignindividual/css (content/css/*)
  content/selfsovereignindividual/fonts (content/fonts/*)
  content/selfsovereignindividual/img (content/img/*)
  content/selfsovereignindividual/selfsovereignindividual.html (content/selfsovereignindividual.html)
  content/selfsovereignindividual/js/main.bundle.js (content/js/main.bundle.js)
  content/selfsovereignindividual/js/vendor.bundle.js (content/js/vendor.bundle.js)
  content/selfsovereignindividual/js/entry.js (content/js/entry.js)
